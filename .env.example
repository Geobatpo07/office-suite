# ================= GLOBAL =================
COMPOSE_PROJECT_NAME=office_suite
NETWORK_NAME=office_net
TZ=Etc/UTC

# ================= NEXTCLOUD =================
NEXTCLOUD_DB_USER=nc_admin
NEXTCLOUD_DB_PASSWORD=changeme
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=changeme
# Doit correspondre EXACTEMENT au secret du client "nextcloud-client"
# dans keycloak/realm-office.json (voir la note sur HEDGEDOC_OAUTH_SECRET
# plus bas : meme logique, meme raison).
NEXTCLOUD_OIDC_SECRET=changeme-nextcloud-oidc-secret

# ================= ONLYOFFICE =================
JWT_SECRET=changeme

# ================= HEDGEDOC =================
HEDGEDOC_DB_USER=hedge_admin
HEDGEDOC_DB_PASSWORD=changeme
HEDGEDOC_DB_NAME=hedgedoc
HEDGEDOC_SESSION_SECRET=changeme
# Doit correspondre EXACTEMENT au secret du client "hedgedoc-client"
# dans keycloak/realm-office.json (importe automatiquement au premier
# demarrage de Keycloak). Ne le changez ici que si vous editez aussi
# ce fichier JSON avant le premier `docker compose up`.
HEDGEDOC_OAUTH_SECRET=changeme-hedgedoc-oauth-secret

# ================= KEYCLOAK =================
KEYCLOAK_USER=admin
KEYCLOAK_PASSWORD=changeme
